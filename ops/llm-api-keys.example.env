# =============================================================================
# ops/llm-api-keys.example.env — template env cho AI service (DATN)
# =============================================================================
# Copy sang ops/llm-api-keys.env rồi điền key thật:
#   cp ops/llm-api-keys.example.env ops/llm-api-keys.env
# File ops/llm-api-keys.env đã được .gitignore, không commit lên git.
#
# AI service load env này khi start (docker-compose env_file hoặc uvicorn .env).
# =============================================================================

# --- LLM provider chính ---
# Chọn 1 trong 2 (Gemini rẻ + structured output tốt; Claude chất lượng cao hơn).
# Nếu có cả 2, LLM_PROVIDER quyết định provider mặc định.
LLM_PROVIDER=gemini                    # gemini | anthropic
LLM_MODEL=gemini-2.0-flash             # hoặc: claude-haiku-4-5, claude-sonnet-4-6

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=CHANGE_ME

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=CHANGE_ME

# --- Inter-service auth ---
# Shared secret Core <-> AI (header X-Internal-Auth).
# DATN-only; production nên dùng service-to-service JWT.
INTERNAL_AUTH_TOKEN=CHANGE_ME_TO_RANDOM_32_BYTES

# --- Cost guardrail ---
# Nếu token/day vượt ngưỡng này, AI service trả 429 và log alert.
LLM_DAILY_TOKEN_BUDGET=200000          # ~$0.10/day với Gemini Flash

# --- Feature flags ---
AI_CACHE_ENABLED=true
AI_DETECTOR_ENABLED=true
