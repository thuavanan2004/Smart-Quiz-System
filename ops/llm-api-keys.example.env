# =============================================================================
# ops/llm-api-keys.example.env — template env cho AI service (DATN, budget $0)
# =============================================================================
# Copy sang ops/llm-api-keys.env rồi điền key thật:
#   cp ops/llm-api-keys.example.env ops/llm-api-keys.env
# File ops/llm-api-keys.env đã được .gitignore, không commit lên git.
#
# Chiến lược provider (ADR-008):
#   Tier 1 — Gemini 2.0 Flash free tier  (primary)
#   Tier 2 — Ollama local llama3.1:8b    (fallback khi Gemini quota/rate hit)
#   Tier 3 — degraded mode               (essay → teacher chấm tay)
#
# AI service load env này khi start (docker-compose env_file hoặc uvicorn .env).
# =============================================================================

# -----------------------------------------------------------------------------
# Tier 1 — Gemini free tier (primary)
# -----------------------------------------------------------------------------
# Đăng ký miễn phí tại https://aistudio.google.com/app/apikey
# Quota free (2026): 15 RPM · 1500 req/day · 1M tokens/day cho gemini-2.0-flash.
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_API_KEY=CHANGE_ME

# Guard rail (để buffer, tránh bị Google throttle 429)
LLM_PRIMARY_RATE_LIMIT_RPM=12
LLM_PRIMARY_DAILY_TOKEN_LIMIT=900000

# -----------------------------------------------------------------------------
# Tier 2 — Ollama local (fallback)
# -----------------------------------------------------------------------------
# Bật bằng: docker compose -f infra/docker-compose.dev.yml --profile ai-fallback up -d ollama
# Pull model 1 lần:
#   docker compose -f infra/docker-compose.dev.yml --profile ai-fallback exec ollama ollama pull llama3.1:8b
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_BASE_URL=http://localhost:11434
LLM_FALLBACK_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# Routing
# -----------------------------------------------------------------------------
# Ngưỡng quota remaining (%) để preemptive switch sang tier 2.
# Dưới ngưỡng này, tier 1 chỉ phục vụ priority cao (grade_essay, generate_from_document).
LLM_PREEMPTIVE_FALLBACK_RATIO=0.1

# -----------------------------------------------------------------------------
# Inter-service auth
# -----------------------------------------------------------------------------
# Shared secret Core <-> AI (header X-Internal-Auth).
# DATN-only; production nên dùng service-to-service JWT.
INTERNAL_AUTH_TOKEN=CHANGE_ME_TO_RANDOM_32_BYTES

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
AI_CACHE_ENABLED=true
AI_CACHE_PROMPT_VERSION=1          # bump khi sửa prompt template → invalidate cache
AI_DETECTOR_ENABLED=true
